# =====================================================================
# BoticaAnita - variables de entorno del backend
# ---------------------------------------------------------------------
# Uso:
#   1. Copia este archivo como .env (en la misma carpeta backend/)
#   2. Completa los valores que necesites
#   3. Ejecuta el backend con: ./mvnw spring-boot:run
#
# Formato: CLAVE=valor
# - Sin comillas.
# - Sin espacios alrededor del "=".
# - No pongas comentarios en la misma linea del valor.
# - Las lineas que empiezan con # se ignoran.
#
# IMPORTANTE: .env esta en .gitignore. No lo subas al repositorio.
# =====================================================================

# --- Chatbot SofIA (obligatoria para que el chatbot funcione) ---------
# Obtener en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Pagos con tarjeta (obligatoria para cobrar con Stripe) -----------
# Clave secreta de prueba: empieza con sk_test_
# Obtener en https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=

# --- Correo electronico (recuperacion de contrasena, avisos) ----------
# Si se deja comentada, se usa el valor por defecto de application.properties.
# Para Gmail se necesita una "contrasena de aplicacion", no la del correo.
# MAIL_PASSWORD=

# --- Supabase Storage (imagenes de recetas) ---------------------------
# Tienen valores por defecto en application.properties.
# Descomenta solo si quieres usar otra cuenta/bucket.
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET=recetas

# --- Datos de pago manual (Plin / SIP) mostrados en el checkout -------
# Tienen valores por defecto en application.properties.
# PLIN_NUMERO=923623077
# PLIN_TITULAR=Botica Anita
# SIP_NUMERO=923623077
# SIP_TITULAR=Botica Anita

# --- CORS (solo si sirves el frontend desde otro dominio) -------------
# Por defecto el backend ya permite http://localhost:4200.
# CORS_ALLOWED_ORIGINS=https://tu-frontend.com
